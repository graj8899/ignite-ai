# Copy this file to .env and fill in real values. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-placeholder                 # your OpenAI API key
OPENAI_MODEL=gpt-5.1                            # chat/generation model name
EMBEDDING_MODEL=text-embedding-3-small          # embedding model name

# --- Database ---
# Must match the POSTGRES_* values below (host is localhost since apps run on your Mac, not in Docker).
DATABASE_URL=postgresql://ignite:ignite_local_dev@localhost:5432/ignite

# --- App ---
APP_ENV=development                             # development | test | production
LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:3000              # comma-separated allowed origins
AUTH_SECRET=change-me-local-dev-secret          # signing secret for dev-login JWTs

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=ignite                            # db superuser for local dev
POSTGRES_PASSWORD=ignite_local_dev              # db password for local dev
POSTGRES_DB=ignite                              # db name
POSTGRES_PORT=5432                              # host port mapped to container's 5432 (use 5433 if 5432 is taken)
